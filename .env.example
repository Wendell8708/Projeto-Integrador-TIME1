# Copie este arquivo para ".env" (mesma pasta do manage.py) e preencha.
# O ".env" NUNCA vai para o Git. Este ".env.example" vai, mas sem valores reais.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Em producao use uma chave DIFERENTE da local.
SECRET_KEY=

# True so em desenvolvimento. Em producao deixe False (ou apague a linha).
DEBUG=True

# Hosts permitidos, separados por virgula. Producao: <nome>.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens (com https://) autorizadas a enviar formularios, como o login do /admin/.
# Producao: https://<nome>.onrender.com   (em desenvolvimento pode ficar vazio)
CSRF_TRUSTED_ORIGINS=

# Origens do frontend React autorizadas (CORS), separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=piads04
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Local: prefer. Neon (producao): require.
DB_SSLMODE=prefer

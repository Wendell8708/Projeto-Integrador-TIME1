# Copie este arquivo para ".env" (mesma pasta do manage.py) e preencha.
# O ".env" NUNCA vai para o Git. Este ".env.example" vai, mas sem valores reais.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Em producao use uma chave DIFERENTE da local.
SECRET_KEY=

# True so em desenvolvimento. Em producao deixe False (ou apague a linha).
DEBUG=True

# Hosts permitidos, separados por virgula. Producao: <nome>.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens (com https://) autorizadas a enviar formularios, como o login do /admin/.
# Producao: https://<nome>.onrender.com   (em desenvolvimento pode ficar vazio)
CSRF_TRUSTED_ORIGINS=

# Origens do frontend React autorizadas (CORS), separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=piads04
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Local: prefer. Neon (producao): require.
DB_SSLMODE=prefer

# --- Opcionais (ja tem valor padrao) ---
# Minutos sem comunicar ate a placa aparecer como "sem comunicacao" (online=false).
# DEVICE_ONLINE_TOLERANCE_MINUTES=10
# Maximo de itens (leituras + impactos) por lote enviado pela placa.
# IOT_MAX_BATCH_ITEMS=200
# Limites de requisicoes: login por IP e telemetria por placa.
# THROTTLE_LOGIN=10/min
# THROTTLE_IOT=120/min

# --- Seguranca (2FA e IDOR) ---
# Codigo de missao da equipe (aparece nos logs quando um controle bloqueia algo).
SECURITY_MISSION_CODE=
# Chave que cifra os segredos do 2FA no banco. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazia = derivada da SECRET_KEY. ATENCAO: trocar esta chave invalida os 2FA ja cadastrados.
OTP_ENCRYPTION_KEY=
# E-mails (separados por virgula) que entram SEM 2FA: so para a conta de demonstracao. Vazio = ninguem.
MFA_CONTAS_DEMONSTRACAO=
# Intervalos de 30 s aceitos antes/depois do atual (1 = tolera ~30 s de relogio).
# OTP_VALID_WINDOW=1
# Segundos para digitar o codigo depois da senha.
# MFA_TOKEN_MAX_AGE=300
# THROTTLE_MFA=10/min

# --- Chat com Gemini (plano gratuito) ---
# Chave em https://aistudio.google.com (nunca coloque no codigo nem no Git).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_MAX_OUTPUT_TOKENS=512
# GEMINI_TIMEOUT_S=20
# THROTTLE_CHAT=5/min

# --- E-mail: recuperacao de senha e convite de usuario novo ---------------------
# Tela do front que recebe ?uid=...&token=... (ex.: https://seu-front/redefinir-senha)
PASSWORD_RESET_URL=
# Resend (resend.com). Sem estas duas, o convite devolve o link na resposta da API
# para a plataforma entregar por outro canal.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
